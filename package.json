{
  "name": "dsh-plugin-mcp-switch",
  "version": "1.0.0",
  "description": "Per-session MCP switch for DeepSeek Harness: MCP servers start disconnected; the agent opens one inside a chat and only that chat sees the tools. Settings panel, group presets and 24 tests.",
  "type": "module",
  "license": "MIT",
  "author": "yoyococo1234 <yoyococo1234@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoyococo1234/dsh-plugin-mcp-switch.git"
  },
  "homepage": "https://github.com/yoyococo1234/dsh-plugin-mcp-switch#readme",
  "bugs": {
    "url": "https://github.com/yoyococo1234/dsh-plugin-mcp-switch/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "mcp-switch",
    "session-isolation",
    "settings"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host-bridge.mjs",
    "lib/*.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check host-bridge.mjs && node --check client.js && npm test"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
